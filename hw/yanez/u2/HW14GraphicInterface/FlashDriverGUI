# 🔹 Function to save data in MongoDB
def save_data():
    flashDrive = {
        "brand": brand_entry.get(),
        "capacityGB": capacity_entry.get(),
        "price": price_entry.get(),
        "color": color_entry.get(),
        "usbType": usb_entry.get(),
        "stock": stock_entry.get(),
        "warrantyMonths": warranty_entry.get(),
        "discountPercentage": discount_entry.get(),
        "finalPrice": final_price_entry.get()
    }

    # 🔹 Validate input fields
    for key, value in flashDrive.items():
        if not value:
            messagebox.showerror("Error", f"El campo '{key}' no puede estar vacío.")
            return

    # 🔹 Insert into MongoDB
    collection.insert_one(flashDrive)
    messagebox.showinfo("✅ Éxito", f"Flash Drive guardado correctamente!\nPrecio final: ${flashDrive['finalPrice']}")
    clear_fields()

# 🔹 Function to clear input fields
def clear_fields():
    brand_entry.delete(0, tk.END)
    capacity_entry.delete(0, tk.END)
    price_entry.delete(0, tk.END)
    color_entry.delete(0, tk.END)
    usb_entry.delete(0, tk.END)
    stock_entry.delete(0, tk.END)
    warranty_entry.delete(0, tk.END)
    discount_entry.delete(0, tk.END)
    final_price_entry.delete(0, tk.END)

# 🔹 Function to retrieve and display stored records
def view_records():
    records_window = tk.Toplevel(root)
    records_window.title("Stored Flash Drives")

    # 🔹 Fetch data from MongoDB
    records = collection.find()
    for record in records:
        tk.Label(records_window, text=f"📌 {record['brand']} - {record['capacityGB']}GB - ${record['finalPrice']}").pack()

