# Subir colección desde archivo JSON
def subir_coleccion(ruta_archivo):
    if not os.path.exists(ruta_archivo):
        print("❌ Archivo no encontrado.")
        return

    with open(ruta_archivo, "r", encoding="utf-8") as f:
        datos = json.load(f)

    # Limpia la colección antes de subir (opcional)
    coleccion.delete_many({})

    # Inserta los datos (puede ser un dict o lista)
    if isinstance(datos, list):
        coleccion.insert_many(datos)
    else:
        coleccion.insert_one(datos)

    print("✅ Colección subida correctamente.")

# Descargar colección a archivo JSON
def descargar_coleccion(ruta_destino):
    documentos = list(coleccion.find())
    for doc in documentos:
        doc["_id"] = str(doc["_id"])  # Convertir ObjectId a str para guardar en JSON

    with open(ruta_destino, "w", encoding="utf-8") as f:
        json.dump(documentos, f, indent=4)

    print(f"✅ Colección descargada como '{ruta_destino}'")

# Menú interactivo
